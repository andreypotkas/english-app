# ============ Database (для приложения) ============
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=english_app
DB_SYNCHRONIZE=true

# ============ Postgres (образ читает эти переменные) ============
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=english_app

# ============ App ============
APP_PORT=3000

# ============ JWT ============
JWT_SECRET=your-secret-key
JWT_EXPIRES=7d

# ============ Optional ============
NODE_ENV=development
